# AI Trading Desk - Environment Configuration Example
# Do not place real credentials in this file.
# Copy this file to .env and fill in your actual values.

LIVE_EXECUTION_ENABLED=false
DHAN_ENABLED=true
DHAN_CLIENT_ID=your_dhan_client_id_here
DHAN_ACCESS_TOKEN=your_dhan_access_token_here
DHAN_API_BASE_URL=https://api.dhan.co/v2
DHAN_STATIC_IP_CONFIGURED=false
