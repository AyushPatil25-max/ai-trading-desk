# AI Trading Desk - Environment Configuration Example
# Do not place real credentials in this file.
# Copy this file to .env and fill in your actual values.

LIVE_EXECUTION_ENABLED=false
DHAN_ENABLED=true
DHAN_CLIENT_ID=your_dhan_client_id_here
DHAN_ACCESS_TOKEN=your_dhan_access_token_here
DHAN_API_BASE_URL=https://api.dhan.co/v2
DHAN_STATIC_IP_CONFIGURED=false

# Upstox Configuration
UPSTOX_ENABLED=true
UPSTOX_CLIENT_ID=your_upstox_client_id_here
UPSTOX_CLIENT_SECRET=your_upstox_client_secret_here
UPSTOX_ACCESS_TOKEN=your_upstox_access_token_here

MARKET_DATA_PROVIDER=upstox
EXECUTION_PROVIDER=dhan
MARKET_DATA_STALE_THRESHOLD_MS=5000
