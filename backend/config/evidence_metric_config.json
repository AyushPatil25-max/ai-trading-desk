  "evidence_type_rules": {
    "_comment": "Classification rules applied in Python. This section documents the taxonomy only.",
    "DETERMINISTIC_FACT": "Direct extraction from data source, no calculation. E.g. current_price, revenue, eps, policy_rate.",
    "DETERMINISTIC_CALCULATION": "Pure Python formula applied to deterministic inputs. E.g. net_margin, pe_ratio, sharpe_ratio.",
    "LLM_INTERPRETATION": "Qualitative judgment produced by LLM. E.g. trend direction, regime classification, sentiment.",
    "ASSUMPTION": "Analyst assumption stated in output. E.g. TTM period assumption, sector classification assumption.",
    "UNAVAILABLE": "Data was requested but not available. Metric has available=False."
  },

